{
  "name": "setu-server",
  "version": "0.1.0",
  "private": true,
  "description": "Setu 桥 TypeScript backend (sandbox, synthetic data)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "evidence": "tsx src/evidence.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "12.4.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "js-yaml": "^5.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
