{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "screenshots": "next build && playwright test --project=screenshots",
    "e2e": "next build && playwright test --project=smoke",
    "e2e:mock": "NEXT_PUBLIC_MOCK=true next build && playwright test --project=smoke"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
