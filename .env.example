# Setu 桥 - copy to .env. All defaults work OFFLINE with no keys. DATA IS SYNTHETIC.
ALLOW_OFFLINE=true
LLM_PROVIDER=scripted          # scripted | gemini | groq (optional adapters; only ever fed tokenised data)
GEMINI_API_KEY=
GROQ_API_KEY=
DATABASE_URL=sqlite:///./setu.db
# REPLACE in any non-demo environment:
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
HMAC_KEY=dev-only-hmac-key-change-me-0123456789abcdef
AES_KEY_B64=ZGV2LW9ubHktYWVzLWtleS0zMi1ieXRlcy1sb25nISE=
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true                 # enables /demo/* helpers; NEVER enable in production
FX_MODE=fixture                # fixture (labelled SAMPLE rates) | live (open.er-api.com)
